{
  "name": "tigerbook-projects",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": { "node": ">=24", "pnpm": "11.x" },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm build && wrangler deploy",
    "deploy:check": "pnpm build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "lucide-react": "1.26.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "wrangler": "4.166.0"
  }
}
